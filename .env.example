# ========================================
# 林妹妹 Agent v2.0 环境变量配置
# cp .env.example .env && nano .env
# ========================================

# ---- 飞书企业应用（可选）----
# 申请：https://open.feishu.cn → 创建企业应用
FEISHU_APP_ID=cli_axxxxxxxxxxxx
FEISHU_APP_SECRET=QhkMpxxxxxxxxxxxxxxxxxxxx

# ---- 企业微信客户联系（可选）----
# 申请：https://work.weixin.qq.com → 创建应用 → 客户联系
WECOM_CORP_ID=ww_xxxxxxxxxxxx
WECOM_AGENT_ID=1000002
WECOM_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
WECOM_TOKEN=your_token_here
WECOM_ENCODING_AES_KEY=your_aes_key_here

# ---- 搜索 API（金融投研需要）----
# Tavily（申请：https://tavily.com）支持多 Key 逗号分隔轮询
TAVILY_KEYS=tvly-dev-xxx

# Brave（申请：https://brave.com/search/api）
BRAVE_KEYS=BSAxxx

# ---- MiniMax（可选）----
MINIMAX_API_KEY=

# ---- 数据加密（必填）----
# 生成密钥：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- 调试模式 ----
# DEBUG=true
